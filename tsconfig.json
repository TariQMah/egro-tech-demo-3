{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@xcan/*": ["../devoreo-erechnung/src/lib/*"]
    }
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "vitest.config.ts", "xcan.config.ts"]
}
